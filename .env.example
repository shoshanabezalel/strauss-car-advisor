# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — bypasses RLS. Used by API routes and scripts, never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM (required from M3). Google AI Studio key for Gemini.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: Gemini model id for the agent (default gemini-3.5-flash).
# "mock" = scripted model for local dev without LLM access (refused in production; see README).
AGENT_MODEL=
# Optional, mock mode only: delay per model step in ms, so progress is visible.
AGENT_MOCK_DELAY_MS=
# Optional: tag for new conversations ("app" default; the e2e server sets "e2e").
CONVERSATION_SOURCE=
# Optional, browser: Realtime polling fallback (src/lib/realtime/ping-fallback.ts). "off" disables it (e2e sets this,
# so tests prove Realtime itself). Defaults: on, start after 5000 ms without a subscription, poll every 5000 ms.
NEXT_PUBLIC_REALTIME_POLL=
NEXT_PUBLIC_REALTIME_FALLBACK_MS=
NEXT_PUBLIC_REALTIME_POLL_MS=
# Fallback model (M7): on Gemini 429 / 503 the turn retries once, then runs on the fallback. Optional; without one
# the chat shows a "busy" message instead. FALLBACK_MODEL's prefix picks the provider:
#   gemini-…  a second Gemini model on the same Google key, e.g. gemini-3.5-flash-lite (must differ from AGENT_MODEL)
#   claude-…  needs ANTHROPIC_API_KEY. With only ANTHROPIC_API_KEY set, the fallback is claude-haiku-5-5.
FALLBACK_MODEL=
ANTHROPIC_API_KEY=

# Security (M7). Required: the server refuses to sign sessions or topics without APP_SECRET, and the rep screen
# can't be opened without REP_ACCESS_CODE. A Vercel build fails if either is missing or too short.
# APP_SECRET: at least 32 characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
APP_SECRET=
# The rep screen's shared access code (at least 8 characters). Demo scope; per-rep sign-in is the pilot step.
REP_ACCESS_CODE=
# Optional: multiplies every rate limit (src/lib/security/rate-limit.ts). Only the e2e server sets it (20).
RATE_LIMIT_SCALE=

# Dev tooling only: personal access token for the Supabase MCP (scripts/supabase-mcp.mjs).
# The app never reads it. Create at https://supabase.com/dashboard/account/tokens, scoped to this project, with a short expiry.
SUPABASE_ACCESS_TOKEN=
