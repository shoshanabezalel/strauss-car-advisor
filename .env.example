# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — bypasses RLS. Used by API routes and scripts, never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM (required from M3). Google AI Studio key for Gemini.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: Gemini model id for the agent (default gemini-3.5-flash).
AGENT_MODEL=
# Optional fallback model.
ANTHROPIC_API_KEY=

# Dev tooling only: personal access token for the Supabase MCP (scripts/supabase-mcp.mjs).
# The app never reads it. Create at https://supabase.com/dashboard/account/tokens, scoped to this project, with a short expiry.
SUPABASE_ACCESS_TOKEN=
